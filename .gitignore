# python
__pycache__/
*.py[cod]
*.ipynb_checkpoints/
.venv*/
.env

# data & outputs
data/**
!data/.gitkeep
# `data/**` does not match sibling copies such as "data copy/". Ignore any
# directory whose name starts with "data" so a stray Finder duplicate cannot be
# committed to what is a public repository.
data*/
!data/
reports/**
!reports/.gitkeep
logs/**
!logs/.gitkeep

# OS/editor
.DS_Store
.idea/
.vscode/
# Python packaging
*.egg-info/
